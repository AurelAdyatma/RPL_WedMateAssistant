<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.paint.ImagePattern?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.Cursor?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rplbo.app.rpl_wedmateassistant.controller.WelcomeController"
      alignment="CENTER" spacing="50"
      style="-fx-background-color: #FDF8F3; -fx-padding: 50;">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="Welcome to WedMate" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3C2415;"/>
        <Label text="Your Assistant for Wedding Dress" style="-fx-font-size: 16px; -fx-text-fill: #9C8575;"/>
    </VBox>

    <!-- Cards -->
    <HBox alignment="CENTER" spacing="30">
        
        <!-- Card User -->
        <VBox fx:id="cardUser" alignment="CENTER" spacing="20" prefWidth="350" prefHeight="280"
              style="-fx-background-color: transparent;"
              onMouseClicked="#handleUserClick">
            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                <StackPane>
                    <!-- Outer aesthetic ring -->
                    <Circle radius="102" fill="transparent" stroke="#E8D5C4" strokeWidth="4">
                        <effect>
                            <DropShadow color="#8B5E3C30" radius="20" spread="0.1"/>
                        </effect>
                    </Circle>
                    <!-- Inner avatar -->
                    <Circle radius="90" stroke="#8B5E3C" strokeWidth="3">
                        <fill>
                            <ImagePattern>
                                <image>
                                    <Image url="@../images/user_avatar.png"/>
                                </image>
                            </ImagePattern>
                        </fill>
                    </Circle>
                </StackPane>
            </VBox>
            <HBox alignment="CENTER" style="-fx-padding: 0 0 25 0;">
                <Label text="Login sebagai " style="-fx-font-size: 16px; -fx-text-fill: #7A6555;"/>
                <Label text="User" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3C2415;"/>
            </HBox>
        </VBox>

        <!-- Card Admin -->
        <VBox fx:id="cardAdmin" alignment="CENTER" spacing="20" prefWidth="350" prefHeight="280"
              style="-fx-background-color: transparent;"
              onMouseClicked="#handleAdminClick">
            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                <StackPane>
                    <!-- Outer aesthetic ring -->
                    <Circle radius="102" fill="transparent" stroke="#E8D5C4" strokeWidth="4">
                        <effect>
                            <DropShadow color="#8B5E3C30" radius="20" spread="0.1"/>
                        </effect>
                    </Circle>
                    <!-- Inner avatar -->
                    <Circle radius="90" stroke="#8B5E3C" strokeWidth="3">
                        <fill>
                            <ImagePattern>
                                <image>
                                    <Image url="@../images/admin_avatar.png"/>
                                </image>
                            </ImagePattern>
                        </fill>
                    </Circle>
                </StackPane>
            </VBox>
            <HBox alignment="CENTER" style="-fx-padding: 0 0 25 0;">
                <Label text="Login sebagai " style="-fx-font-size: 16px; -fx-text-fill: #7A6555;"/>
                <Label text="Admin" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3C2415;"/>
            </HBox>
        </VBox>

    </HBox>

    <Button text="Lanjutkan" onAction="#handleLanjutkan" 
            style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 25; -fx-cursor: hand;" />

</VBox>
