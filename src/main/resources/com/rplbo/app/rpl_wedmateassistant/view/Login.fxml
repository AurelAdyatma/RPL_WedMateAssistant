<?xml version="1.0" encoding="UTF-8"?>

<!-- Deklarasi komponen JavaFX yang digunakan dalam file FXML ini -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<!-- Root container menggunakan StackPane agar elemen berada di tengah, dan di-binding ke LoginController -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.rplbo.app.rpl_wedmateassistant.controller.LoginController"
           style="-fx-background-color: #F8FAFC;">

    <children>
        <!-- VBox sebagai container utama untuk kartu login -->
        <VBox alignment="CENTER"
              spacing="20"
              maxWidth="400"
              style="-fx-background-color: white;
                     -fx-background-radius: 15;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

            <!-- Header Login: Menampilkan nama aplikasi dan judul form -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="WedMate"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #D97706;" />
                <Label text="Admin Login"
                       style="-fx-font-size: 14px; -fx-text-fill: #64748B;" />
            </VBox>

            <!-- Container form input (username dan password) -->
            <VBox spacing="15" style="-fx-padding: 10 0 0 0;">
                <!-- Grup input Username -->
                <VBox spacing="5">
                    <Label text="Username" style="-fx-font-size: 13px; -fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtUsername"
                               promptText="Masukkan username"
                               prefHeight="45"
                               style="-fx-background-color: #F1F5F9;
                                      -fx-background-radius: 8;
                                      -fx-padding: 0 15;
                                      -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 8;" />
                </VBox>

                <!-- Grup input Password (disembunyikan karakternya) -->
                <VBox spacing="5">
                    <Label text="Password" style="-fx-font-size: 13px; -fx-text-fill: #1E293B; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="txtPassword"
                                   promptText="Masukkan password"
                                   prefHeight="45"
                                   style="-fx-background-color: #F1F5F9;
                                          -fx-background-radius: 8;
                                          -fx-padding: 0 15;
                                          -fx-border-color: #E2E8F0;
                                          -fx-border-radius: 8;" />
                </VBox>
            </VBox>

            <!-- Label Error untuk menampilkan pesan jika login gagal -->
            <Label fx:id="lblError"
                   text=""
                   visible="false"
                   managed="false"
                   wrapText="true"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 12px;" />

            <!-- Container aksi tombol (Login dan Kembali) -->
            <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <!-- Tombol aksi utama untuk memproses login -->
                <Button fx:id="btnLogin"
                        text="Masuk"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: #1E293B;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;" />
                
                <!-- Tombol kembali ke halaman Welcome utama -->
                <Button fx:id="btnKembali"
                        text="Kembali ke Menu Utama"
                        onAction="#handleKembali"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #64748B;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </children>
</StackPane>
