<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.rplbo.app.rpl_wedmateassistant.controller.LoginController"
           style="-fx-background-color: #FDF8F3;">

    <children>
        <VBox alignment="CENTER"
              spacing="20"
              maxWidth="400"
              style="-fx-background-color: #FFFCF8;
                     -fx-background-radius: 15;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(three-pass-box, rgba(139,94,60,0.10), 15, 0, 0, 5);">

            <VBox alignment="CENTER" spacing="8">
                <Label text="WedMate"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #C8956C;" />
                <Label text="Admin Login"
                       style="-fx-font-size: 14px; -fx-text-fill: #9C8575;" />
            </VBox>

            <VBox spacing="15" style="-fx-padding: 10 0 0 0;">
                <VBox spacing="5">
                    <Label text="Username" style="-fx-font-size: 13px; -fx-text-fill: #3C2415; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtUsername"
                               promptText="Masukkan username"
                               prefHeight="45"
                               style="-fx-background-color: #FFF5EC;
                                      -fx-background-radius: 8;
                                      -fx-padding: 0 15;
                                      -fx-border-color: #E8D5C4;
                                      -fx-border-radius: 8;" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Password" style="-fx-font-size: 13px; -fx-text-fill: #3C2415; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="txtPassword"
                                   promptText="Masukkan password"
                                   prefHeight="45"
                                   style="-fx-background-color: #FFF5EC;
                                          -fx-background-radius: 8;
                                          -fx-padding: 0 15;
                                          -fx-border-color: #E8D5C4;
                                          -fx-border-radius: 8;" />
                </VBox>
            </VBox>

            <Label fx:id="lblError"
                   text=""
                   visible="false"
                   managed="false"
                   wrapText="true"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 12px;" />

            <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnLogin"
                        text="Masuk"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: #8B5E3C;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;" />
                
                <Button fx:id="btnKembali"
                        text="Kembali ke Menu Utama"
                        onAction="#handleKembali"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #9C8575;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </children>
</StackPane>
